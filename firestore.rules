rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /links/{linkId} {
      // Anyone scanning a QR needs to read the destination + bump the
      // scan counter — that request is NOT authenticated (it's a stranger's
      // phone). We only allow it to touch "scans" and "lastScannedAt".
      allow get: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['scans', 'lastScannedAt']);

      // Only the signed-in owner can create, list, or fully edit their own links.
      allow list: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
  }
}
